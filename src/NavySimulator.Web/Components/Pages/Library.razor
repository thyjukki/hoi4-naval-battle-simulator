@page "/library"
@inject Workspace Workspace

<PageTitle>Library · NavySimulator</PageTitle>

<div class="page-head">
    <h1>Library</h1>
    <span class="muted">The content designs and scenarios are built from (read-only). Hulls, modules and ship types come from the game (<code>NavySimulator import-ship-data</code>). Values are as written in the JSON: +flat, ~averaged, % multiplied.</span>
</div>

<div class="panel">
    <div class="tabs">
        @foreach (var (key, label, count) in Tabs())
        {
            <button class="@(tab == key ? "on" : "")" @onclick="() => tab = key">@label <span class="count">@count</span></button>
        }
        <span class="right" style="padding: 4px 0"><input type="search" placeholder="Filter…" @bind="filter" @bind:event="oninput" /></span>
    </div>
    <div class="scroll" style="max-height: calc(100vh - 220px)">
        @switch (tab)
        {
            case "hulls":
                <table class="data compact">
                    <thead>
                        <tr>
                            <th>Hull</th><th>ID</th><th>Archetype</th><th class="num">Year</th><th class="num" title="Fixed + custom slots; hover for the allowed categories">Slots</th><th class="num">Manpower</th><th class="num" title="naval_dominance_factor: the hull's naval dominance before speed, range, heavy attack and carrier size">Dominance</th>
                            @foreach (var stat in HullStats)
                            {
                                <th class="num">@stat.Label</th>
                            }
                            <th>File</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var hull in Workspace.Catalog.Hulls.Where(hull => Matches(hull.ID, hull.Name, hull.ArchetypeName, hull.Archetype)))
                        {
                            var stats = hull.BaseStats.ToDomain();
                            var fixedSlots = hull.Slots.Count(DesignSlots.IsFixed);
                            <tr>
                                <td>@(hull.Name ?? hull.ID)</td>
                                <td class="muted small">@hull.ID</td>
                                <td class="muted">@(hull.ArchetypeName ?? hull.Archetype)</td>
                                <td class="num">@hull.Year</td>
                                <td class="num" title="@SlotSummary(hull)">@fixedSlots + @(hull.Slots.Count - fixedSlots)</td>
                                <td class="num">@hull.Manpower</td>
                                <td class="num">@(hull.NavalDominanceFactor == 0 ? "" : hull.NavalDominanceFactor.ToString("0.##"))</td>
                                @foreach (var stat in HullStats)
                                {
                                    <td class="num">@(stat.Get(stats) == 0 ? "" : stat.Display(stats))</td>
                                }
                                <td class="faint small">@Workspace.Catalog.SourceFileOf(hull)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                break;

            case "modules":
                <table class="data compact">
                    <thead><tr><th>Category</th><th>Module</th><th>ID</th><th>Effect</th><th>Design rules</th><th class="num">Used in</th></tr></thead>
                    <tbody>
                        @foreach (var module in Workspace.Catalog.Modules.Where(module => Matches(module.ID, module.Name, module.ShortName, Workspace.ModuleCategory(module))))
                        {
                            <tr>
                                <td class="muted">@Workspace.ModuleCategory(module)</td>
                                <td>@DesignSlots.ModuleLabel(module)</td>
                                <td class="muted small">@module.ID</td>
                                <td class="small">@StatInfo.Summarize(module.StatModifiers, module.StatAverages, module.StatMultipliers)</td>
                                <td class="small muted">@ModuleRules(module)</td>
                                <td class="num">@Workspace.Catalog.ShipDesigns.Count(design => design.Modules.ContainsValue(module.ID))</td>
                            </tr>
                        }
                    </tbody>
                </table>
                break;

            case "shipTypes":
                <table class="data compact">
                    <thead><tr><th>Ship type</th><th>ID</th><th>Role</th><th>Hulls</th><th>Needs one of</th><th class="num">Organization</th><th class="num" title="The highest priority wins when several types accept a design">Priority</th></tr></thead>
                    <tbody>
                        @foreach (var shipType in Workspace.Catalog.ShipTypes.Where(shipType => Matches(shipType.ID, shipType.Name, shipType.Role)))
                        {
                            <tr>
                                <td>@(shipType.Name ?? shipType.ID)</td>
                                <td class="muted small">@shipType.ID</td>
                                <td>@shipType.Role</td>
                                <td class="muted">@string.Join(", ", shipType.Hulls)</td>
                                <td class="small">@(shipType.RequiredModules.Count == 0 ? "–" : string.Join(", ", shipType.RequiredModules.Select(id => DesignSlots.ModuleLabelOf(Workspace.Catalog, id))))</td>
                                <td class="num">@shipType.Organization</td>
                                <td class="num">@shipType.Priority</td>
                            </tr>
                        }
                    </tbody>
                </table>
                break;

            case "mios":
                <table class="data compact">
                    <thead><tr><th>MIO</th><th>ID</th><th>Countries</th><th>Covers</th><th>Initial trait</th><th class="num" title="Hover for the traits and their equipment bonuses">Traits</th><th>File</th></tr></thead>
                    <tbody>
                        @foreach (var mio in Workspace.Catalog.Mios.Where(mio => Matches(mio.ID, mio.Name, string.Join(" ", mio.Countries))))
                        {
                            <tr class="@(mio.ArchetypeOnly || mio.DebugOnly ? "faint" : "")">
                                <td>@(mio.Name ?? mio.ID)</td>
                                <td class="muted small">@mio.ID</td>
                                <td class="muted">@(mio.ArchetypeOnly ? "archetype only" : mio.DebugOnly ? "debug mode only" : string.Join(", ", mio.Countries))</td>
                                <td class="small">@string.Join(", ", mio.EquipmentTypes.Select(GroupName))</td>
                                <td class="small">@(mio.InitialTrait is { } initial ? MioInfo.Summarize(initial) : string.Empty)</td>
                                <td class="num" title="@TraitList(mio)">@mio.Traits.Count</td>
                                <td class="faint small">@Workspace.Catalog.SourceFileOf(mio)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <h4 style="margin: 14px 10px 6px">Policies</h4>
                <table class="data compact">
                    <thead><tr><th>Policy</th><th>ID</th><th>For MIOs with</th><th>Equipment bonus</th><th>Conditions</th></tr></thead>
                    <tbody>
                        @foreach (var policy in Workspace.Catalog.MioPolicies.Where(policy => Matches(policy.ID, policy.Name)))
                        {
                            <tr>
                                <td>@(policy.Name ?? policy.ID)</td>
                                <td class="muted small">@policy.ID</td>
                                <td class="small muted">@(policy.AllowedEquipmentTypes.Count == 0 ? "any" : string.Join(", ", policy.AllowedEquipmentTypes.Select(GroupName)))</td>
                                <td class="small">@MioInfo.Summarize(policy)</td>
                                <td class="small faint">@string.Join("; ", policy.Conditions.Where(condition => !condition.StartsWith("allowed = { OR = { has_mio_equipment_type", StringComparison.Ordinal)))</td>
                            </tr>
                        }
                    </tbody>
                </table>
                break;

            case "researches":
                <table class="data compact">
                    <thead><tr><th>File</th><th>Research</th><th>Applies to</th><th>Effect</th><th>Kind</th></tr></thead>
                    <tbody>
                        @foreach (var research in Workspace.Catalog.Researches.Where(research => Matches(research.ID, Workspace.Catalog.SourceFileOf(research))))
                        {
                            <tr>
                                <td class="muted">@Path.GetFileNameWithoutExtension(Workspace.Catalog.SourceFileOf(research))</td>
                                <td>@research.ID</td>
                                <td class="muted">@Scope(research.AppliesToRoles, research.AppliesToTypes)</td>
                                <td class="small">@ModifierInfo.SummarizeResearch(research)</td>
                                <td class="small" title="Equipment bonuses go into the design multiplier (S-STATS-BONUS); technologies scale the ship (S-STATS-SHIP)">@(research.EquipmentBonus ? "equipment bonus" : "technology")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                break;

            case "spirits":
                <table class="data compact">
                    <thead><tr><th>Slot</th><th>Spirit</th><th>Needs</th><th>Effect</th></tr></thead>
                    <tbody>
                        @foreach (var spirit in Workspace.Spirits.Where(spirit => Matches(spirit.ID, spirit.Name, spirit.Category)))
                        {
                            <tr>
                                <td class="muted">@(spirit.CategoryName ?? spirit.Category)</td>
                                <td title="@spirit.ID">@(spirit.Name ?? spirit.ID)</td>
                                <td class="small">
                                    @string.Join(" and ", spirit.RequiredDoctrines.Select(group => string.Join(" or ", group)))
                                    @if (spirit.OtherConditions.Count > 0)
                                    {
                                        <span class="muted" title="Not checked by the simulator">@(spirit.RequiredDoctrines.Count > 0 ? "; " : "")@string.Join("; ", spirit.OtherConditions)</span>
                                    }
                                </td>
                                <td class="small">@DoctrineInfo.Summarize(spirit.Effects)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                break;

            case "doctrines":
                <table class="data compact">
                    <thead><tr><th>Folder</th><th>Doctrine</th><th>Track</th><th>Effect</th></tr></thead>
                    <tbody>
                        @foreach (var folder in Workspace.DoctrineFolders)
                        {
                            @foreach (var doctrine in folder.GrandDoctrines.Where(doctrine => Matches(doctrine.ID, doctrine.Name)))
                            {
                                <tr>
                                    <td class="muted">@(folder.Name ?? folder.ID)</td>
                                    <td title="@doctrine.ID"><strong>@(doctrine.Name ?? doctrine.ID)</strong></td>
                                    <td class="muted">grand doctrine</td>
                                    <td class="small">@DoctrineInfo.Summarize(doctrine.Effects)</td>
                                </tr>
                                @foreach (var (track, milestone) in doctrine.Milestones)
                                {
                                    <tr>
                                        <td></td>
                                        <td class="muted">milestone</td>
                                        <td class="muted">@track</td>
                                        <td class="small">@DoctrineInfo.Summarize(milestone)</td>
                                    </tr>
                                }
                            }
                            @foreach (var subdoctrine in folder.Subdoctrines.Where(subdoctrine => Matches(subdoctrine.ID, subdoctrine.Name, string.Join(" ", subdoctrine.Tracks))))
                            {
                                <tr>
                                    <td class="muted">@(folder.Name ?? folder.ID)</td>
                                    <td title="@subdoctrine.ID">@(subdoctrine.Name ?? subdoctrine.ID)</td>
                                    <td class="muted">@string.Join(", ", subdoctrine.Tracks)</td>
                                    <td class="small">@DoctrineInfo.Summarize(subdoctrine.Effects)</td>
                                </tr>
                                @foreach (var (reward, threshold, _) in DoctrineInfo.Rewards(subdoctrine, 0))
                                {
                                    <tr>
                                        <td></td>
                                        <td class="muted" title="@reward.ID">↳ @(reward.Name ?? reward.ID)</td>
                                        <td class="muted num">@threshold</td>
                                        <td class="small">@DoctrineInfo.Summarize(reward.Effects)</td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
                break;

            default:
                <table class="data compact">
                    <thead>
                        <tr>
                            <th>Plane</th><th>Name</th><th title="Naval battle role (A-WINGS): strike wings attack ships, fighter-type wings defend carriers">Role</th><th title="Carrier capable">CV</th><th class="num">Year</th><th class="num">Air attack</th><th class="num">Air defense</th><th class="num">Naval attack</th><th class="num">Naval targeting</th>
                            <th class="num">Agility</th><th class="num">Speed</th><th class="num">Air superiority</th><th class="num">Reliability</th><th class="num">Cost</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var plane in Workspace.Catalog.Planes.Where(plane => Matches(plane.ID) || Matches(plane.Name ?? string.Empty)))
                        {
                            <tr>
                                <td>@plane.ID</td>
                                <td>@plane.Name</td>
                                <td class="muted small">@(Workspace.Library.Planes.TryGetValue(plane.ID, out var equipment) ? CarrierLoadouts.Role(equipment, Engine.Defines.GameDefines.Vanilla().Hardcoded) : "?")</td>
                                <td>@(plane.CarrierCapable ? "✓" : "")</td>
                                <td class="num">@plane.Year</td>
                                <td class="num">@plane.Stats.AirAttack</td>
                                <td class="num">@plane.Stats.AirDefense</td>
                                <td class="num">@plane.Stats.NavalAttack</td>
                                <td class="num">@plane.Stats.NavalTargeting</td>
                                <td class="num">@plane.Stats.Agility</td>
                                <td class="num">@plane.Stats.Speed</td>
                                <td class="num">@plane.Stats.AirSuperiority</td>
                                <td class="num">@plane.Stats.Reliability.ToString("P0")</td>
                                <td class="num">@plane.Stats.ProductionCost</td>
                            </tr>
                        }
                    </tbody>
                </table>
                break;
        }
    </div>
</div>

@code {
    private static readonly IReadOnlyList<StatInfo> HullStats =
        StatInfo.All.Where(stat => stat.Key is "hp" or "armor" or "speed" or "navalRange" or "reliability" or "surfaceVisibility" or "subVisibility"
            or "surfaceDetection" or "subDetection" or "productionCost").ToList();

    private string tab = "hulls";
    private string filter = string.Empty;

    private IEnumerable<(string Key, string Label, int Count)> Tabs()
    {
        var catalog = Workspace.Catalog;
        yield return ("hulls", "Hulls", catalog.Hulls.Count);
        yield return ("modules", "Modules", catalog.Modules.Count);
        yield return ("shipTypes", "Ship types", catalog.ShipTypes.Count);
        yield return ("mios", "MIOs", catalog.Mios.Count);
        yield return ("researches", "Researches", catalog.Researches.Count);
        yield return ("doctrines", "Doctrines", catalog.DoctrineFolders.Sum(folder => folder.GrandDoctrines.Count + folder.Subdoctrines.Count));
        yield return ("spirits", "Spirits", catalog.Spirits.Count);
        yield return ("planes", "Planes", catalog.Planes.Count);
    }

    private bool Matches(params string?[] values)
    {
        return filter.Length == 0 || values.Any(value => value?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true);
    }

    private string SlotSummary(HullDto hull)
    {
        return string.Join("\n", hull.Slots.Select(slot =>
            $"{DesignSlots.SlotLabel(slot)}{(slot.Required ? " (required)" : "")}: {string.Join(", ", slot.AllowedCategories.Select(CategoryName))}"));
    }

    private string ModuleRules(ModuleDto module)
    {
        var rules = module.ForbiddenCategories.Select(category => $"forbids {CategoryName(category)}")
            .Concat(module.AddEquipmentTypes.Select(type => $"adds {type}"));
        return string.Join(", ", rules);
    }

    // An equipment group's name ("All Battleship"), or the token itself.
    private string GroupName(string token)
    {
        return Workspace.Catalog.EquipmentGroups.FirstOrDefault(group => group.ID == token)?.Name ?? token;
    }

    private static string TraitList(MioDto mio)
    {
        return string.Join("\n", mio.Traits.Select(trait => $"{trait.Name ?? trait.ID}: {MioInfo.Summarize(trait)}"));
    }

    private string CategoryName(string category)
    {
        return Workspace.Catalog.Modules.FirstOrDefault(module => module.Category == category)?.CategoryName ?? category;
    }

    private static string Scope(List<string> roles, List<string>? types)
    {
        var scopes = roles.Concat(types ?? []).ToList();
        return scopes.Count == 0 ? "all ships" : string.Join(", ", scopes);
    }
}
