@page "/designs"
@implements IDisposable
@inject Workspace Workspace

<PageTitle>Designs · NavySimulator</PageTitle>

<div class="page-head">
    <h1>Ship designs</h1>
    <span class="muted">Hull + a module per slot + optional MIO, in <code>ship-designs/</code>. The ship type follows from the hull and modules (S-DESIGN); stats follow S-STATS-DESIGN.</span>
    <button class="right" @onclick="NewDesign">New design</button>
</div>

@if (message is not null)
{
    <div class="message @(messageIsError ? "error" : "info")" style="margin-bottom: 14px">@message</div>
}
@if (pendingId is not null)
{
    <div class="message warning row" style="margin-bottom: 14px">
        <span>@(editing?.ID) has unsaved changes.</span>
        <button class="small" @onclick="() => Select(pendingId, true)">Discard and open @pendingId</button>
        <button class="small ghost" @onclick="() => pendingId = null">Keep editing</button>
    </div>
}

<div class="panel" style="margin-bottom: 14px">
    <div class="panel-head">
        <input type="search" placeholder="Filter designs, hulls, types, modules…" @bind="filter" @bind:event="oninput" style="width: 260px" />
        <div class="button-group">
            <button class="small @(roleFilter is null ? "on" : "")" @onclick="() => roleFilter = null">All</button>
            @foreach (var role in Enum.GetValues<ShipRole>())
            {
                <button class="small @(roleFilter == role ? "on" : "")" @onclick="() => roleFilter = role">@role</button>
            }
        </div>
        <span class="muted small right">@Rows().Count designs · click a column to sort</span>
    </div>
    <div class="scroll" style="max-height: 340px">
        <table class="data compact">
            <thead>
                <tr>
                    <th class="sortable" @onclick="@(() => SortBy("id"))">Design @Arrow("id")</th>
                    <th class="sortable" @onclick="@(() => SortBy("hull"))">Hull @Arrow("hull")</th>
                    <th class="sortable" @onclick="@(() => SortBy("type"))">Type @Arrow("type")</th>
                    <th>Role</th>
                    <th class="num">Modules</th>
                    @foreach (var stat in StatInfo.Headline)
                    {
                        <th class="num sortable" title="@stat.Label" @onclick="() => SortBy(stat.Key)">@stat.Short @Arrow(stat.Key)</th>
                    }
                    <th class="num">Fleets</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Rows())
                {
                    <tr class="clickable @(row.Design.ID == selectedId ? "selected" : "")" @onclick="() => Select(row.Design.ID)">
                        <td>
                            @row.Design.ID
                            @if (row.Issues > 0)
                            {
                                <span class="warn small" title="Breaks @row.Issues designer rule(s); open it to see which"> ⚠</span>
                            }
                            @if (row.Design.AllowAnyModule)
                            {
                                <span class="faint small" title="Module restrictions overridden"> (any module)</span>
                            }
                        </td>
                        <td class="muted" title="@row.Design.HullID">@row.HullName</td>
                        <td>@row.TypeName</td>
                        <td>@row.Role</td>
                        <td class="num">@row.Design.Modules.Count</td>
                        @foreach (var stat in StatInfo.Headline)
                        {
                            <td class="num">@(row.Stats is null ? "" : stat.Display(row.Stats))</td>
                        }
                        <td class="num">@row.Fleets</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (editing is null)
{
    <div class="panel"><p class="empty">Pick a design above, or create a new one.</p></div>
}
else
{
    var problems = new List<string>();
    var stats = Workspace.DesignStats(editing, problems);
    var hull = Workspace.FindHull(editing.HullID);
    var (shipType, typeMatches) = Workspace.ShipTypeOf(editing);
    var slotRows = DesignSlots.Rows(Workspace.Catalog, Workspace.Library, editing);
    var designIssues = DesignSlots.DesignIssues(Workspace.Library, editing);
    var assignableMios = Workspace.AssignableMios(editing);
    var mio = Workspace.FindMio(editing.MioID);
    <div class="split wide-left">
        <div class="stack">
            <div class="panel">
                <div class="panel-head">
                    <h2>@(isNew ? "New design" : originalId)</h2>
                    @if (Dirty)
                    {
                        <span class="badge escaped">unsaved</span>
                    }
                    <div class="row tight right">
                        <button class="primary" @onclick="Save" disabled="@(!Dirty)">Save</button>
                        <button class="ghost" @onclick="Revert" disabled="@(!Dirty || isNew)">Revert</button>
                        <button @onclick="Duplicate" disabled="@isNew">Duplicate</button>
                        <button class="danger" @onclick="Delete" disabled="@isNew">Delete</button>
                    </div>
                </div>
                <div class="panel-body stack">
                    <div class="fields">
                        <div class="field span-2">
                            <label>ID</label>
                            <input type="text" @bind="editing.ID" @bind:event="oninput" />
                            @if (!isNew && editing.ID != originalId && usedBy.Count > 0)
                            {
                                <span class="hint warn">Renaming also renames it in @string.Join(", ", usedBy).</span>
                            }
                        </div>
                        <div class="field span-2">
                            <label>File</label>
                            <FilePicker Folder="@CatalogWriter.ShipDesignsFolder" @bind-Value="file" />
                        </div>
                        <div class="field span-2">
                            <label>Hull</label>
                            <select value="@editing.HullID" @onchange="args => ChangeHull(args.Value?.ToString())" class="@(hull is null ? "invalid" : "")">
                                @if (hull is null)
                                {
                                    <option value="@editing.HullID">@(string.IsNullOrEmpty(editing.HullID) ? "(choose a hull)" : $"{editing.HullID} (unknown)")</option>
                                }
                                @foreach (var group in Workspace.Catalog.Hulls.GroupBy(item => item.ArchetypeName ?? item.Archetype))
                                {
                                    <optgroup label="@group.Key">
                                        @foreach (var item in group)
                                        {
                                            <option value="@item.ID">@(item.Name ?? item.ID)@(item.Year is { } year ? $" ({year})" : "")</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <span class="hint">@editing.HullID</span>
                        </div>
                        <div class="field span-2">
                            <label>MIO</label>
                            <select class="@(editing.MioID is not null && (mio is null || assignableMios.All(candidate => candidate.ID != mio.ID)) ? "invalid" : "")"
                                    @bind:get="editing.MioID ?? string.Empty" @bind:set="SetMio">
                                <option value="">(none)</option>
                                @if (editing.MioID is not null && assignableMios.All(candidate => candidate.ID != editing.MioID))
                                {
                                    <option value="@editing.MioID">@(mio is null ? $"{editing.MioID} (unknown)" : $"{MioInfo.Label(mio)} (does not cover this design)")</option>
                                }
                                @foreach (var group in assignableMios.GroupBy(MioInfo.Group).OrderBy(group => group.Key.EndsWith(')') ? 1 : 0).ThenBy(group => group.Key, StringComparer.Ordinal))
                                {
                                    <optgroup label="@group.Key">
                                        @foreach (var candidate in group)
                                        {
                                            <option value="@candidate.ID">@MioInfo.Label(candidate)</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <span class="hint">
                                @if (mio?.InitialTrait is { } initial)
                                {
                                    <span>Initial trait: @(MioInfo.Summarize(initial) is { Length: > 0 } effect ? effect : "no effect in battle"). </span>
                                }
                                @(Workspace.Catalog.Mios.Count == 0 ? "No MIOs imported (Settings → Data)." : "Only MIOs that cover this hull are listed. In the scenario editor each side can assign another MIO to the design and unlocks traits and a policy; the stats here have the initial trait only.")
                            </span>
                        </div>
                        <div class="field span-2">
                            <label>Ship type</label>
                            <div class="row tight">
                                <span>@(shipType?.Name ?? shipType?.ID ?? "none")</span>
                                @if (shipType is not null)
                                {
                                    <span class="badge role">@shipType.Role</span>
                                }
                                @if (shipType is not null && !typeMatches)
                                {
                                    <span class="badge escaped" title="No ship type accepts this hull with these modules; the game would not build it">fallback</span>
                                }
                            </div>
                            <span class="hint">Picked from the hull and modules, e.g. the armor (S-DESIGN-TYPE).</span>
                        </div>
                        <div class="field span-2">
                            <label>Module restrictions</label>
                            <label class="check"><input type="checkbox" @bind:get="editing.AllowAnyModule" @bind:set="SetAllowAnyModule" /> Allow any module</label>
                            <span class="hint">Overrides slot categories, forbidden modules, count limits and required slots.</span>
                        </div>
                    </div>
                    @if (usedBy.Count > 0)
                    {
                        <p class="small muted">Used by fleets: @foreach (var fleet in usedBy) { <a href="@($"fleets?id={Uri.EscapeDataString(fleet)}")" style="margin-right: 8px">@fleet</a> }</p>
                    }
                </div>
            </div>

            <div class="panel">
                <div class="panel-head">
                    <h2>Modules</h2>
                    <span class="muted small">@editing.Modules.Count of @(hull?.Slots.Count ?? 0) slots fitted</span>
                    <div class="row tight right">
                        <button class="small" @onclick="UseDefaults" disabled="@(hull is null)" title="The hull's default variant in the game">Hull defaults</button>
                        <button class="small ghost" @onclick="() => editing.Modules.Clear()" disabled="@(editing.Modules.Count == 0)">Clear</button>
                    </div>
                </div>
                <div class="panel-body module-list">
                    @if (designIssues.Count > 0)
                    {
                        <div class="message @(editing.AllowAnyModule ? "info" : "warning")">
                            @foreach (var issue in designIssues)
                            {
                                <div class="small">@(editing.AllowAnyModule ? "Overridden: " : "")@DesignSlots.Describe(Workspace.Catalog, issue)</div>
                            }
                        </div>
                    }
                    @foreach (var group in slotRows.GroupBy(row => DesignSlots.IsFixed(row.Slot) ? "Fixed slots" : "Custom slots"))
                    {
                        <div class="list-group slot-group">@group.Key</div>
                        @foreach (var row in group)
                        {
                            var slotId = row.Slot.ID;
                            var flagged = row.Issues.Any(issue => !issue.IsRestriction || !editing.AllowAnyModule);
                            <div class="slot-row">
                                <span class="slot-name" title="@slotId">
                                    @DesignSlots.SlotLabel(row.Slot)
                                    @if (row.Slot.Required)
                                    {
                                        <span class="required" title="Required">*</span>
                                    }
                                </span>
                                <select value="@(row.ModuleID ?? string.Empty)" @onchange="args => SetModule(slotId, args.Value?.ToString())"
                                        class="@(flagged ? "invalid" : "")" title="@(row.Module is null ? "" : ModuleSummary(row.Module))">
                                    <option value="">(empty)</option>
                                    @if (row.ModuleID is not null && row.Module is null)
                                    {
                                        <option value="@row.ModuleID">@row.ModuleID (unknown)</option>
                                    }
                                    @SlotOptions(row)
                                </select>
                            </div>
                            @if (row.Module is not null)
                            {
                                <div class="slot-note faint">@ModuleSummary(row.Module)</div>
                            }
                            @foreach (var issue in row.Issues)
                            {
                                var overridden = issue.IsRestriction && editing.AllowAnyModule;
                                <div class="slot-note @(overridden ? "muted" : "warn")">@(overridden ? "Overridden: " : "")@DesignSlots.Describe(Workspace.Catalog, issue)</div>
                            }
                        }
                    }
                    @if (hull is null)
                    {
                        <p class="empty">Choose a hull to fit modules.</p>
                    }
                </div>
            </div>
        </div>

        <div class="panel">
            <div class="panel-head">
                <h2>Stats</h2>
                <div class="row tight right small">
                    <span class="muted">with researches of</span>
                    <div class="button-group">
                        <button class="small @(researchSide == "none" ? "on" : "")" @onclick="@(() => researchSide = "none")">none</button>
                        <button class="small @(researchSide == "attacker" ? "on" : "")" @onclick="@(() => researchSide = "attacker")">attacker</button>
                        <button class="small @(researchSide == "defender" ? "on" : "")" @onclick="@(() => researchSide = "defender")">defender</button>
                    </div>
                </div>
            </div>
            <div class="panel-head">
                <span class="small muted">Compare with</span>
                <select @bind="compareWith" class="grow">
                    <option value="@SavedOption">the saved version</option>
                    <option value="">nothing</option>
                    @foreach (var design in Workspace.Catalog.ShipDesigns.Where(design => design.ID != originalId))
                    {
                        <option value="@design.ID">@design.ID</option>
                    }
                </select>
            </div>
            @if (problems.Count > 0)
            {
                <div class="panel-body"><div class="message error">@string.Join("; ", problems)</div></div>
            }
            @if (stats is not null)
            {
                var shown = Shown(editing) ?? stats;
                var other = Comparison();
                <div class="panel-body flush">
                    <table class="data compact">
                        <thead>
                            <tr>
                                <th>Stat</th>
                                <th class="num">@(researchSide == "none" ? "Design" : $"Ship ({researchSide})")</th>
                                @if (other is not null)
                                {
                                    <th class="num">@(compareWith == SavedOption ? "Saved" : compareWith)</th>
                                    <th class="num">Change</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in StatInfo.All.Where(stat => stat.Get(shown) != 0 || (other is not null && stat.Get(other) != 0)).GroupBy(stat => stat.Group))
                            {
                                <tr><td colspan="4" class="list-group" style="padding: 4px 8px">@group.Key</td></tr>
                                @foreach (var stat in group)
                                {
                                    var value = stat.Get(shown);
                                    var otherValue = other is null ? 0 : stat.Get(other);
                                    var delta = value - otherValue;
                                    <tr>
                                        <td class="muted">@stat.Label</td>
                                        <td class="num">@stat.Display(value)</td>
                                        @if (other is not null)
                                        {
                                            <td class="num faint">@stat.Display(otherValue)</td>
                                            <td class="num @(Math.Abs(delta) < 1e-9 ? "faint" : (delta > 0) == stat.HigherIsBetter ? "ok" : "bad")">
                                                @(Math.Abs(delta) < 1e-9 ? "–" : (delta > 0 ? "+" : "") + stat.Display(delta))
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    private const string SavedOption = "\u0000saved";

    private string filter = string.Empty;
    private ShipRole? roleFilter;
    private string sortKey = "id";
    private bool sortDescending;
    private string? selectedId;
    private string? originalId;
    private string originalJson = string.Empty;
    private string? originalFile;
    private ShipDesignDto? editing;
    private ShipDesignDto? saved;
    private string file = string.Empty;
    private bool isNew;
    private string? pendingId;
    private string researchSide = "none";
    private string compareWith = SavedOption;
    private IReadOnlyList<string> usedBy = [];
    private string? message;
    private bool messageIsError;
    private string? confirmDelete;

    [SupplyParameterFromQuery(Name = "id")] public string? IdFromQuery { get; set; }

    private bool Dirty => editing is not null && (isNew || Workspace.Json(editing) != originalJson || file != originalFile);

    protected override void OnInitialized()
    {
        Workspace.Changed += OnWorkspaceChanged;
    }

    protected override void OnParametersSet()
    {
        if (IdFromQuery is { } id && id != selectedId)
        {
            Select(id, true);
        }
    }

    private void OnWorkspaceChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private sealed record DesignRow(ShipDesignDto Design, string HullName, string TypeName, ShipRole? Role, ShipStats? Stats, int Fleets, int Issues);

    private List<DesignRow> Rows()
    {
        var rows = Workspace.Catalog.ShipDesigns
            .Select(design =>
            {
                var (type, matches) = Workspace.ShipTypeOf(design);
                var issues = design.AllowAnyModule ? 0 : Workspace.Library.CheckDesign(design)?.Issues.Count ?? 0;
                return new DesignRow(
                    design,
                    Workspace.FindHull(design.HullID)?.Name ?? design.HullID,
                    type is null ? string.Empty : (type.Name ?? type.ID) + (matches ? string.Empty : " (fallback)"),
                    Workspace.RoleOf(design),
                    Workspace.DesignStats(design),
                    Workspace.FleetsUsingDesign(design.ID).Count,
                    issues);
            })
            .Where(row => roleFilter is null || row.Role == roleFilter)
            .Where(row => filter.Length == 0 || Matches(row));
        var stat = StatInfo.All.FirstOrDefault(candidate => candidate.Key == sortKey);
        var ordered = sortKey switch
        {
            "hull" => rows.OrderBy(row => row.HullName, StringComparer.Ordinal),
            "type" => rows.OrderBy(row => row.TypeName, StringComparer.Ordinal),
            _ when stat is not null => rows.OrderBy(row => row.Stats is null ? double.MinValue : stat.Get(row.Stats)),
            _ => rows.OrderBy(row => row.Design.ID, StringComparer.Ordinal)
        };
        var list = ordered.ToList();

        if (sortDescending)
        {
            list.Reverse();
        }

        return list;
    }

    private bool Matches(DesignRow row)
    {
        return new[] { row.Design.ID, row.Design.HullID, row.HullName, row.TypeName }
                   .Any(value => value.Contains(filter, StringComparison.OrdinalIgnoreCase)) ||
               row.Design.Modules.Values.Any(module => module.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
                                                       DesignSlots.ModuleLabelOf(Workspace.Catalog, module).Contains(filter, StringComparison.OrdinalIgnoreCase));
    }

    private void SortBy(string key)
    {
        sortDescending = sortKey == key ? !sortDescending : key is not ("id" or "hull" or "type");
        sortKey = key;
    }

    private string Arrow(string key)
    {
        return sortKey != key ? string.Empty : sortDescending ? "▾" : "▴";
    }

    private void Select(string id, bool force = false)
    {
        if (!force && Dirty && id != selectedId)
        {
            pendingId = id;
            return;
        }

        pendingId = null;
        message = null;
        var design = Workspace.FindDesign(id);

        if (design is null)
        {
            return;
        }

        selectedId = id;
        originalId = id;
        saved = Workspace.Clone(design);
        editing = Workspace.Clone(design);
        originalJson = Workspace.Json(editing);
        originalFile = Workspace.Catalog.SourceFileOf(design) ?? $"{CatalogWriter.ShipDesignsFolder}/custom.json";
        file = originalFile;
        isNew = false;
        usedBy = Workspace.FleetsUsingDesign(id);
        confirmDelete = null;
    }

    private void NewDesign()
    {
        if (Dirty)
        {
            message = "Save or revert the current design first.";
            messageIsError = true;
            return;
        }

        selectedId = null;
        originalId = null;
        saved = null;
        editing = new ShipDesignDto { ID = "new_design", HullID = Workspace.Catalog.Hulls.FirstOrDefault()?.ID ?? string.Empty };
        DesignSlots.UseDefaults(Workspace.Catalog, editing);
        originalJson = string.Empty;
        originalFile = null;
        file = Workspace.Catalog.FilesIn(CatalogWriter.ShipDesignsFolder).FirstOrDefault() ?? $"{CatalogWriter.ShipDesignsFolder}/custom.json";
        isNew = true;
        usedBy = [];
        compareWith = string.Empty;
        message = null;
    }

    private void Save()
    {
        try
        {
            Workspace.SaveDesign(editing!, file, isNew ? null : originalId);
            var savedId = editing!.ID;
            Select(savedId, true);
            message = $"Saved {savedId} to {file}.";
            messageIsError = false;
        }
        catch (Exception exception) when (exception is InvalidOperationException or IOException or UnauthorizedAccessException or ArgumentException or InvalidDataException)
        {
            message = exception.Message;
            messageIsError = true;
        }
    }

    private void Revert()
    {
        Select(originalId!, true);
    }

    private void Duplicate()
    {
        var copy = Workspace.Clone(editing!);
        var id = editing!.ID + "_copy";

        for (var i = 2; Workspace.FindDesign(id) is not null; i++)
        {
            id = $"{editing.ID}_copy{i}";
        }

        copy.ID = id;
        editing = copy;
        selectedId = null;
        originalId = null;
        isNew = true;
        usedBy = [];
        message = "Duplicated. Save to create it.";
        messageIsError = false;
    }

    private void Delete()
    {
        if (confirmDelete != originalId)
        {
            confirmDelete = originalId;
            message = $"Click Delete again to remove {originalId} from {originalFile}.";
            messageIsError = true;
            return;
        }

        var blockers = Workspace.DeleteDesign(originalId!);

        if (blockers.Count > 0)
        {
            message = $"{originalId} is used by {string.Join(", ", blockers)}; remove it from those fleets first.";
            messageIsError = true;
            confirmDelete = null;
            return;
        }

        message = $"Deleted {originalId}.";
        messageIsError = false;
        editing = null;
        selectedId = null;
        confirmDelete = null;
    }

    private void SetMio(string? value)
    {
        editing!.MioID = string.IsNullOrEmpty(value) ? null : value;
    }

    private void SetModule(string slotId, string? value)
    {
        DesignSlots.SetModule(Workspace.Catalog, editing!, slotId, value);
    }

    private void SetAllowAnyModule(bool value)
    {
        editing!.AllowAnyModule = value;
    }

    private void ChangeHull(string? hullId)
    {
        if (string.IsNullOrEmpty(hullId) || hullId == editing!.HullID)
        {
            return;
        }

        var removed = DesignSlots.ChangeHull(Workspace.Catalog, editing, hullId);
        message = removed.Count == 0 ? null : $"Removed from slots the new hull lacks or does not allow them in: {string.Join(", ", removed)}.";
        messageIsError = false;
    }

    private void UseDefaults()
    {
        DesignSlots.UseDefaults(Workspace.Catalog, editing!);
    }

    private string ModuleSummary(ModuleDto module)
    {
        var effect = StatInfo.Summarize(module.StatModifiers, module.StatAverages, module.StatMultipliers);
        var forbids = module.ForbiddenCategories.Count == 0 ? string.Empty : $" · forbids {string.Join(", ", module.ForbiddenCategories.Select(CategoryName))}";
        var adds = module.AddEquipmentTypes.Count == 0 ? string.Empty : $" · adds {string.Join(", ", module.AddEquipmentTypes)}";
        return effect + forbids + adds;
    }

    private string CategoryName(string category)
    {
        return Workspace.Catalog.Modules.FirstOrDefault(module => module.Category == category)?.CategoryName ?? category;
    }

    private RenderFragment SlotOptions(SlotRow row) => __builder =>
    {
        var options = DesignSlots.Options(Workspace.Catalog, row.Slot, editing!.AllowAnyModule).ToList();

        if (row.Module is not null && !options.Contains(row.Module))
        {
            options.Insert(0, row.Module);
        }

        @foreach (var group in options.GroupBy(module => DesignSlots.Allows(row.Slot, module) ? Workspace.ModuleCategory(module) : $"{Workspace.ModuleCategory(module)} (not allowed here)"))
        {
            <optgroup label="@group.Key">
                @foreach (var module in group)
                {
                    <option value="@module.ID">@DesignSlots.ModuleLabel(module)</option>
                }
            </optgroup>
        }
    };

    private ShipStats? Shown(ShipDesignDto design)
    {
        return researchSide switch
        {
            "attacker" => Workspace.ShipStats(design, Workspace.Scenario.Attacker),
            "defender" => Workspace.ShipStats(design, Workspace.Scenario.Defender),
            _ => Workspace.DesignStats(design)
        };
    }

    private ShipStats? Comparison()
    {
        if (compareWith == SavedOption)
        {
            return saved is null ? null : Shown(saved);
        }

        return string.IsNullOrEmpty(compareWith) || Workspace.FindDesign(compareWith) is not { } design ? null : Shown(design);
    }

    public void Dispose()
    {
        Workspace.Changed -= OnWorkspaceChanged;
    }
}
