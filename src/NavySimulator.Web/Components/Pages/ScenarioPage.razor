@page "/scenario"
@implements IDisposable
@inject Workspace Workspace
@inject NavigationManager Navigation

<PageTitle>Scenario · NavySimulator</PageTitle>

<div class="page-head">
    <h1>Scenario</h1>
    <select @bind="fileToOpen" aria-label="Scenario file">
        @foreach (var file in files)
        {
            <option value="@file">@file</option>
        }
    </select>
    <button @onclick="Open" disabled="@(string.IsNullOrEmpty(fileToOpen))">Open</button>
    <button @onclick="New">New</button>
    <div class="sep"></div>
    <button class="primary" @onclick="Save" disabled="@(Workspace.ScenarioFile is null || !Workspace.ScenarioDirty)">Save</button>
    <input type="text" placeholder="new-file.json" @bind="saveAsName" style="width: 170px" aria-label="Save as file name" />
    <button @onclick="SaveAs" disabled="@string.IsNullOrWhiteSpace(saveAsName)">Save as</button>
    <button class="ghost" @onclick="Revert" disabled="@(!Workspace.ScenarioDirty)">Revert</button>
    <span class="small muted">
        @(Workspace.ScenarioFile ?? "not saved yet")
        @if (Workspace.ScenarioDirty)
        {
            <span class="warn"> · unsaved changes</span>
        }
    </span>
    <button class="right primary" @onclick="GoToBattle" disabled="@(build is null || build.Errors.Count > 0)">Start battle ▸</button>
</div>

@if (message is not null)
{
    <div class="message @(messageIsError ? "error" : "info")" style="margin-bottom: 14px">@message</div>
}
@if (Workspace.ScenarioLoadError is { } loadError)
{
    <div class="message error" style="margin-bottom: 14px">@loadError</div>
}

<div class="message @(build is null ? "" : build.Errors.Count > 0 ? "error" : "info")" style="margin-bottom: 14px">
    @if (build is null || validating)
    {
        <span class="muted">Validating…</span>
    }
    else if (build.Errors.Count > 0)
    {
        <strong>@build.Errors.Count problem@(build.Errors.Count == 1 ? "" : "s") stop this scenario from running</strong>
        <ul>@foreach (var error in build.Errors) { <li>@error</li> }</ul>
    }
    else
    {
        <span class="ok">✓ Valid.</span>
        <span class="muted">
            @build.Scenario!.Attacker.Fleet.Ships.Count vs @build.Scenario.Defender.Fleet.Ships.Count ships ·
            defines: @string.Join(" → ", build.Scenario.Defines.Sources)
            @if (build.DefinesReport is { } report && report.Applied.Count > 0)
            {
                <span> (@report.Applied.Count values applied)</span>
            }
        </span>
    }
    @if (build is not null && build.Warnings.Count > 0)
    {
        <details style="margin-top: 6px">
            <summary class="small warn" style="cursor: pointer">@build.Warnings.Count warnings about ignored content</summary>
            <ul class="small muted">@foreach (var warning in build.Warnings) { <li>@warning</li> }</ul>
        </details>
    }
</div>

<div class="grid-3" style="margin-bottom: 14px">
    <div class="panel">
        <div class="panel-head"><h2>General</h2></div>
        <div class="panel-body fields">
            <div class="field span-2">
                <label>ID</label>
                <input type="text" @bind="Scenario.ID" @bind:after="Edited" />
            </div>
            <div class="field">
                <label>Max hours</label>
                <input type="number" min="1" @bind="Scenario.MaxHours" @bind:after="Edited" />
                <span class="hint">Safety stop; 0 uses @(new BattleRules().MaxHours).</span>
            </div>
            <div class="field">
                <label>Iterations</label>
                <input type="number" min="1" @bind="Scenario.Iterations" @bind:after="Edited" />
                <span class="hint">Runs per batch.</span>
            </div>
            <div class="field">
                <label>Seed</label>
                <input type="number" placeholder="random" @bind="Scenario.Seed" @bind:after="Edited" />
                <span class="hint">Empty: random each time.</span>
            </div>
            <div class="field span-2">
                <label class="check"><input type="checkbox" @bind:get="!(Scenario.DontRetreat ?? false)" @bind:set="SetRetreat" /> Ships may retreat</label>
                <label class="check"><input type="checkbox" @bind:get="Scenario.ContinueAfterRetreat ?? false" @bind:set="SetContinue" /> Re-engage after a side fully escaped</label>
                <span class="hint">Both are tooling options, not game mechanics.</span>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head"><h2>Location and weather</h2><span class="muted small">sea region, night, weather, naval terrain</span></div>
        <div class="panel-body fields">
            @{
                var region = LocationInfo.Region(Workspace.Catalog, Scenario.RegionID);
                var defines = build?.Scenario?.Defines ?? NavySimulator.Engine.Defines.GameDefines.Vanilla();
                var weatherOff = !(Rules?.WeatherEnabled ?? DefaultRules.WeatherEnabled);
            }
            <div class="field span-2">
                <label>Sea region</label>
                @if (Workspace.Catalog.SeaRegions.Count == 0)
                {
                    <span class="hint">No sea regions imported (Settings → Import sea regions).</span>
                }
                else
                {
                    <select @bind:get="Scenario.RegionID?.ToString() ?? string.Empty" @bind:set="SetRegion">
                        <option value="">None (no region weather, night window)</option>
                        @foreach (var (id, label) in LocationInfo.Regions(Workspace.Catalog))
                        {
                            <option value="@id">@label</option>
                        }
                    </select>
                }
            </div>
            @if (region is not null)
            {
                <div class="field">
                    <label>Battle province</label>
                    <select @bind:get="Scenario.ProvinceID?.ToString() ?? string.Empty" @bind:set="SetProvince">
                        <option value="">First (@(region.Provinces.FirstOrDefault()?.ID))</option>
                        @foreach (var province in region.Provinces)
                        {
                            <option value="@province.ID">@province.ID (x @province.X, y @province.Y)</option>
                        }
                    </select>
                    <span class="hint">Its position on the map sets the darkness.</span>
                </div>
            }
            <div class="field">
                <label>Start date</label>
                <input type="text" placeholder="1936.5.6" @bind="Scenario.StartDate" @bind:after="Edited" />
                <span class="hint">Day of battle hour 0, as the game writes dates; the hour is the start hour of day.</span>
            </div>
            @if (region is not null && !weatherOff && (Rules?.NightEnabled ?? DefaultRules.NightEnabled) && LocationInfo.NightSummary(region, Scenario.ProvinceID, Scenario.StartDate, defines) is { } night)
            {
                <div class="field span-2"><span class="hint">Night on the start day: @night.</span></div>
            }
            <div class="field">
                <label>Weather</label>
                <select @bind:get="LocationInfo.WeatherChoice(Scenario)" @bind:set="SetWeatherChoice" disabled="@weatherOff">
                    @foreach (var (value, label) in LocationInfo.WeatherChoices)
                    {
                        <option value="@value">@label</option>
                    }
                </select>
                <span class="hint">@(weatherOff ? "Weather is off in the rules (no night either)." : "One weather for the whole battle, or a pattern from the region's weather periods.")</span>
            </div>
            @if (string.Equals(Scenario.Weather, LocationLoader.Simulated, StringComparison.OrdinalIgnoreCase))
            {
                <div class="field">
                    <label>Weather seed</label>
                    <input type="number" placeholder="battle seed" @bind="Scenario.WeatherSeed" @bind:after="Edited" />
                    <span class="hint">Empty: each battle's own seed, so every run gets its own weather.</span>
                </div>
                @if (region is not null && LocationInfo.PeriodSummary(region, Scenario.StartDate, defines) is { } period)
                {
                    <div class="field span-2"><span class="hint">@period. A chance to change every @LocationInfo.VisitHours(region, defines) h.</span></div>
                }
            }
            else
            {
                <div class="field">
                    <label class="check"><input type="checkbox" @bind:get="Scenario.ArcticWater ?? false" @bind:set="SetArcticWater" disabled="@weatherOff" /> Arctic water</label>
                    <span class="hint">weather_arctic_water on top of the weather.</span>
                </div>
            }
            <div class="field span-2">
                <label>Naval terrain</label>
                <select @bind:get="Scenario.Terrain ?? string.Empty" @bind:set="SetTerrain">
                    <option value="">Region's (@LocationInfo.RegionTerrainLabel(region))</option>
                    @foreach (var terrain in Workspace.Content.NavalTerrains)
                    {
                        <option value="@terrain.ID">@(terrain.Name ?? terrain.ID)</option>
                    }
                </select>
                @if (LocationInfo.Terrain(Workspace.Catalog, Scenario) is { } chosen)
                {
                    <span class="hint">@LocationInfo.TerrainSummary(chosen)</span>
                }
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head"><h2>Rules</h2><span class="muted small">mechanics not settled by reverse-engineering</span></div>
        <div class="panel-body fields">
            <div class="field">
                <label>Damage randomness</label>
                <select @bind:get="Rules?.DamageRandomness ?? string.Empty" @bind:set="SetRandomness">
                    <option value="">Game (default)</option>
                    @foreach (var model in Enum.GetNames<DamageRandomnessModel>())
                    {
                        <option value="@model">@model</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Start hour of day</label>
                <input type="number" min="0" max="23" placeholder="@DefaultRules.StartHourOfDay" @bind:get="Rules?.StartHourOfDay" @bind:set="SetStartHour" />
                <span class="hint">Battle hour 0 (the game clock).</span>
            </div>
            <div class="field">
                <label>Night from / to</label>
                <span class="row">
                    <input type="number" min="0" max="23" style="width: 60px" placeholder="@NightDefaults.Start" @bind:get="Rules?.NightStartHour" @bind:set="SetNightStart" />
                    <input type="number" min="0" max="23" style="width: 60px" placeholder="@NightDefaults.End" @bind:get="Rules?.NightEndHour" @bind:set="SetNightEnd" />
                </span>
                <span class="hint">Only without a sea region and start date: the hours of day that are dark. With them, the darkness follows the battle province and the date.</span>
            </div>
            <div class="field">
                <label>Air region phase</label>
                <input type="number" placeholder="@DefaultRules.AirRegionPhase" @bind:get="Rules?.AirRegionPhase" @bind:set="SetAirPhase" />
                <span class="hint">Strategic region id (mod 8): air strikes when hour of day mod 8 equals it.</span>
            </div>
            <div class="field">
                <label class="check"><input type="checkbox" @bind:get="Rules?.NightEnabled ?? DefaultRules.NightEnabled" @bind:set="SetNight" /> Night modifiers</label>
            </div>
            <div class="field">
                <label class="check"><input type="checkbox" @bind:get="Rules?.WeatherEnabled ?? DefaultRules.WeatherEnabled" @bind:set="SetWeather" /> Weather</label>
                <span class="hint">Off is the game with the console command disable_weather.</span>
            </div>
            <div class="field">
                <label class="check"><input type="checkbox" @bind:get="Rules?.NavalDominanceEnabled ?? DefaultRules.NavalDominanceEnabled" @bind:set="SetNavalDominance" /> Naval dominance</label>
                <span class="hint">The side with more naval dominance from its ships at the start (both patrolling the region) regains organization faster (NAVAL_DOMINANCE_ORG_RECOVERY).</span>
            </div>
            <div class="field">
                <label class="check"><input type="checkbox" @bind:get="Rules?.CarrierWingsExecuteNavalStrike ?? DefaultRules.CarrierWingsExecuteNavalStrike" @bind:set="SetCarrierStrike" /> Carrier wings fly naval strikes</label>
                <span class="hint">Carrier strike wings execute a naval strike mission, as logged in game battles (the game's setter is not decoded). Off: carriers do no damage.</span>
            </div>

        </div>
    </div>

    <div class="panel">
        <div class="panel-head"><h2>Defines</h2><span class="muted small">applied over vanilla 1.19.4, in order</span></div>
        <div class="panel-body stack">
            @for (var i = 0; i < Scenario.Defines.Count; i++)
            {
                var index = i;
                <div class="row tight">
                    <input type="text" class="grow" value="@Scenario.Defines[index]" @onchange="args => SetDefine(index, args.Value?.ToString())" />
                    <button class="small icon danger" title="Remove" @onclick="() => RemoveDefine(index)">✕</button>
                </div>
            }
            <div class="row tight">
                <input type="text" class="grow" placeholder="defines/tfb-legacy.lua or a HOI4/mod folder" @bind="newDefine" />
                <button class="small" @onclick="AddDefine" disabled="@string.IsNullOrWhiteSpace(newDefine)">Add</button>
            </div>
            <p class="hint small muted">
                Relative paths are inside the data directory. Saved with the scenario.
                @if (Workspace.ExtraDefineSources.Count > 0)
                {
                    <span>Then the GUI's own sources apply: @string.Join(", ", Workspace.ExtraDefineSources) (<a href="settings">settings</a>).</span>
                }
                else
                {
                    <span>To always apply your mod's defines, add its folder in <a href="settings">Settings</a>.</span>
                }
            </p>
        </div>
    </div>
</div>

<div class="row" style="margin-bottom: 10px">
    <button class="small" @onclick="Swap" title="Exchange the two sides (the attacker fires first each hour)">⇄ Swap sides</button>
    <button class="small" @onclick="Mirror" title="Give the defender the attacker's whole setup">Mirror attacker → defender</button>
    @if (costs is { } cost)
    {
        <div class="right row tight" title="Production cost of each side's ships after its equipment bonuses (researches, doctrines, MIO traits). Carrier air wings, land-based planes and MIO production bonuses are not counted. The Battle and Batch pages show the IC lost.">
            <span class="small muted">Fleet cost</span>
            <span class="attacker nowrap">@cost.Attacker.Total.ToString("N0") IC</span>
            <div class="stacked" style="width: 200px">
                @foreach (var (side, total) in new[] { ("attacker", cost.Attacker.Total), ("defender", cost.Defender.Total) })
                {
                    var share = Share(total, cost.Attacker.Total + cost.Defender.Total);
                    <span style="width: @((share * 100).ToString("F1", CultureInfo.InvariantCulture))%; background: var(--@side)">@(share >= 0.12 ? share.ToString("P0") : "")</span>
                }
            </div>
            <span class="defender nowrap">@cost.Defender.Total.ToString("N0") IC</span>
            @if (cost.Defender.Total > 0)
            {
                <span class="small muted nowrap">@((cost.Attacker.Total / cost.Defender.Total).ToString("F2")) : 1</span>
            }
        </div>
    }
</div>
<div class="grid-2">
    <SideEditor Label="attacker" Side="Scenario.Attacker" Other="Scenario.Defender" Cost="costs?.Attacker" OnChanged="Edited" />
    <SideEditor Label="defender" Side="Scenario.Defender" Other="Scenario.Attacker" Cost="costs?.Defender" OnChanged="Edited" />
</div>

@code {
    private static readonly BattleRules DefaultRules = new();

    private IReadOnlyList<string> files = [];
    private string? fileToOpen;
    private string? saveAsName;
    private string? newDefine;
    private string? message;
    private bool messageIsError;
    private ScenarioBuild? build;
    private (FleetCost Attacker, FleetCost Defender)? costs;
    private bool validating;
    private CancellationTokenSource? pendingValidation;

    private BattleScenarioDto Scenario => Workspace.Scenario;
    private BattleRulesDto? Rules => Scenario.Rules;

    protected override void OnInitialized()
    {
        Workspace.Changed += OnWorkspaceChanged;
        RefreshFiles();
        _ = Validate(0);
    }

    private void OnWorkspaceChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void RefreshFiles()
    {
        files = Workspace.ListScenarioFiles();
        fileToOpen = Workspace.ScenarioFile ?? files.FirstOrDefault();
    }

    private async Task Edited()
    {
        Workspace.ScenarioEdited();
        await Validate(400);
    }

    private async Task Validate(int delayMs)
    {
        pendingValidation?.Cancel();
        var cancellation = new CancellationTokenSource();
        pendingValidation = cancellation;
        validating = true;

        try
        {
            await Task.Delay(delayMs, cancellation.Token);
            var snapshot = Workspace.Clone(Scenario);
            var result = await Task.Run(() => Workspace.BuildScenario(snapshot), cancellation.Token);

            if (!cancellation.IsCancellationRequested)
            {
                build = result;
                costs = result.Scenario is { } built
                    ? (FleetCost.Of(built.Attacker.Fleet.Ships), FleetCost.Of(built.Defender.Fleet.Ships))
                    : null;
                validating = false;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // A newer edit restarted validation.
        }
    }

    private void Do(Action action, string? success = null)
    {
        try
        {
            action();
            message = success;
            messageIsError = false;
        }
        catch (Exception exception) when (exception is InvalidOperationException or IOException or UnauthorizedAccessException or SetupValidationException or ArgumentException)
        {
            message = exception.Message;
            messageIsError = true;
        }
    }

    private async Task Open()
    {
        if (Workspace.ScenarioDirty && fileToOpen != Workspace.ScenarioFile)
        {
            message = "Discarded the unsaved changes of the previous scenario.";
        }

        Do(() => Workspace.OpenScenario(fileToOpen!));
        await Validate(0);
    }

    private async Task New()
    {
        Do(Workspace.NewScenario, "New scenario. Save it under a file name to keep it.");
        await Validate(0);
    }

    private void Save()
    {
        Do(() => Workspace.SaveScenario(), $"Saved {Workspace.ScenarioFile}.");
        RefreshFiles();
    }

    private void SaveAs()
    {
        Do(() => Workspace.SaveScenario(saveAsName), "Saved.");

        if (!messageIsError)
        {
            message = $"Saved as {Workspace.ScenarioFile}.";
        }

        saveAsName = null;
        RefreshFiles();
    }

    private async Task Revert()
    {
        Do(Workspace.RevertScenario, "Reverted to the saved file.");
        await Validate(0);
    }

    private void GoToBattle()
    {
        Navigation.NavigateTo($"?seed={Scenario.Seed ?? Random.Shared.Next(1, 1_000_000)}");
    }

    private async Task Swap()
    {
        (Scenario.Attacker, Scenario.Defender) = (Scenario.Defender, Scenario.Attacker);
        await Edited();
    }

    private async Task Mirror()
    {
        Scenario.Defender = Workspace.Clone(Scenario.Attacker);
        await Edited();
    }

    private static double Share(double part, double whole)
    {
        return whole <= 0 ? 0 : part / whole;
    }

    private BattleRulesDto EnsureRules()
    {
        return Scenario.Rules ??= new BattleRulesDto();
    }

    private async Task SetRandomness(string value)
    {
        EnsureRules().DamageRandomness = string.IsNullOrEmpty(value) ? null : value;
        await Edited();
    }

    private async Task SetStartHour(int? value)
    {
        EnsureRules().StartHourOfDay = value;
        await Edited();
    }

    private async Task SetAirPhase(int? value)
    {
        EnsureRules().AirRegionPhase = value;
        await Edited();
    }

    private static (int Start, int End) NightDefaults => (new NavySimulator.Engine.Defines.HardcodedValues().NightStartHour,
        new NavySimulator.Engine.Defines.HardcodedValues().NightEndHour);

    private async Task SetRegion(string? value)
    {
        Scenario.RegionID = int.TryParse(value, out var id) ? id : null;
        Scenario.ProvinceID = null;
        await Edited();
    }

    private async Task SetProvince(string? value)
    {
        Scenario.ProvinceID = int.TryParse(value, out var id) ? id : null;
        await Edited();
    }

    private async Task SetWeatherChoice(string? value)
    {
        Scenario.Weather = string.IsNullOrWhiteSpace(value) ? "clear" : value;

        if (string.Equals(Scenario.Weather, LocationLoader.Simulated, StringComparison.OrdinalIgnoreCase))
        {
            Scenario.ArcticWater = null;
        }

        await Edited();
    }

    private async Task SetArcticWater(bool value)
    {
        Scenario.ArcticWater = value ? true : null;
        await Edited();
    }

    private async Task SetTerrain(string? value)
    {
        Scenario.Terrain = value ?? string.Empty;
        await Edited();
    }

    private async Task SetNightStart(int? value)
    {
        EnsureRules().NightStartHour = value;
        await Edited();
    }

    private async Task SetNightEnd(int? value)
    {
        EnsureRules().NightEndHour = value;
        await Edited();
    }

    private async Task SetNight(bool value)
    {
        EnsureRules().NightEnabled = value == DefaultRules.NightEnabled ? null : value;
        await Edited();
    }

    private async Task SetWeather(bool value)
    {
        EnsureRules().WeatherEnabled = value == DefaultRules.WeatherEnabled ? null : value;
        await Edited();
    }

    private async Task SetCarrierStrike(bool value)
    {
        EnsureRules().CarrierWingsExecuteNavalStrike = value == DefaultRules.CarrierWingsExecuteNavalStrike ? null : value;
        await Edited();
    }

    private async Task SetNavalDominance(bool value)
    {
        EnsureRules().NavalDominanceEnabled = value == DefaultRules.NavalDominanceEnabled ? null : value;
        await Edited();
    }

    private async Task SetRetreat(bool value)
    {
        Scenario.DontRetreat = !value;
        await Edited();
    }

    private async Task SetContinue(bool value)
    {
        Scenario.ContinueAfterRetreat = value;
        await Edited();
    }

    private async Task SetDefine(int index, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            Scenario.Defines.RemoveAt(index);
        }
        else
        {
            Scenario.Defines[index] = value.Trim();
        }

        await Edited();
    }

    private async Task RemoveDefine(int index)
    {
        Scenario.Defines.RemoveAt(index);
        await Edited();
    }

    private async Task AddDefine()
    {
        Scenario.Defines.Add(newDefine!.Trim());
        newDefine = null;
        await Edited();
    }

    public void Dispose()
    {
        Workspace.Changed -= OnWorkspaceChanged;
        pendingValidation?.Cancel();
    }
}
