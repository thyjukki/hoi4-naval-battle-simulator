    private async Task SetDesignMio(ShipDesignDto design, string value)
    {
        if (string.IsNullOrEmpty(value) || value == design.MioID)
        {
            Side.DesignMios.Remove(design.ID);
        }
        else
        {
            Side.DesignMios[design.ID] = value == NoMio ? string.Empty : value;
        }

        await Changed();
    }

    // Folded section summaries.
    private string DoctrineSummary()
    {
        var parts = Workspace.DoctrineFolders
            .Where(folder => Side.Doctrines.ContainsKey(folder.ID))
            .Select(folder => folder.GrandDoctrines.FirstOrDefault(doctrine => doctrine.ID == Side.Doctrines[folder.ID].GrandDoctrine)?.Name ?? Side.Doctrines[folder.ID].GrandDoctrine)
            .ToList();
        return parts.Count == 0 ? "none" : string.Join(" · ", parts);
    }

    private string MioSummary()
    {
        if (Workspace.Catalog.Mios.Count == 0)
        {
            return "not imported";
        }

        var assigned = designs.Count(design => Workspace.EffectiveMioId(Side, design) is not null);
        var traits = Side.Mios.Values.Sum(setup => setup.Traits.Count);
        var country = string.IsNullOrEmpty(Side.Country) ? string.Empty : $"{Side.Country} · ";
        return $"{country}{assigned} / {designs.Count} designs with an MIO · {traits} traits unlocked";
    }

    private static string SelectionSummary(IEnumerable<string> items)
    {
        var list = items.ToList();
        return list.Count switch
        {
            0 => "none",
            <= 3 => string.Join(", ", list),
            _ => $"{list.Count} selected"
        };
    }

