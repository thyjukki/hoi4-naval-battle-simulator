    private bool IsStriker(string planeId)
    {
        return Workspace.Library.Planes.TryGetValue(planeId, out var plane) && plane.IsNavalStriker(Vanilla.Hardcoded);
    }

    private static string PlaneLabel(PlaneDto plane)
    {
        return plane.Name is { } name ? $"{name} ({plane.ID})" : plane.ID;
    }

    private async Task AddLandBased()
    {
        var striker = Workspace.Catalog.Planes.LastOrDefault(plane => plane.Archetype == "nav_bomber_equipment") ??
                      Workspace.Catalog.Planes.FirstOrDefault(plane => IsStriker(plane.ID));
        Side.LandBasedAirwings.Add(new LandBasedAirwingDto { PlaneID = striker?.ID ?? string.Empty, Planes = 100 });
        await Changed();
    }

    private async Task RemoveLandBased(LandBasedAirwingDto landBased)
    {
        Side.LandBasedAirwings.Remove(landBased);
        await Changed();
    }

    /// <summary>Planes not in the stockpile yet, the side's own (carrier wings, land-based) first.</summary>
    private IEnumerable<PlaneDto> StockpileCandidates()
    {
        var used = Workspace.FindFleet(Side.FleetID) is { } fleet
            ? fleet.CarrierAirwings.Values.SelectMany(loadouts => loadouts).SelectMany(loadout => loadout.Wings).Select(wing => wing.PlaneID)
            : [];
        var own = used.Concat(Side.LandBasedAirwings.Select(entry => entry.PlaneID)).ToHashSet(StringComparer.Ordinal);
        return Workspace.Catalog.Planes.Where(plane => !Side.PlaneStockpile.ContainsKey(plane.ID)).OrderBy(plane => own.Contains(plane.ID) ? 0 : 1);
    }

    private async Task AddStockpile(string planeId)
    {
