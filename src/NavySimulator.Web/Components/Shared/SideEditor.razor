    // The source names of BattleParticipant.ActiveEffects: a grand doctrine, subdoctrine or spirit ID,
    // "subdoctrine/reward" or "grand/track milestone".
    private string EffectSummary(string source)
    {
        var folders = Workspace.Catalog.DoctrineFolders;
        var parts = source.Split('/');
        var milestone = parts.Length == 2 && parts[1].EndsWith(" milestone", StringComparison.Ordinal);
        var dto = parts.Length == 1
            ? folders.SelectMany(folder => folder.GrandDoctrines).FirstOrDefault(item => item.ID == source)?.Effects
              ?? folders.SelectMany(folder => folder.Subdoctrines).FirstOrDefault(item => item.ID == source)?.Effects
              ?? Workspace.Catalog.Spirits.FirstOrDefault(item => item.ID == source)?.Effects
            : milestone
                ? folders.SelectMany(folder => folder.GrandDoctrines).FirstOrDefault(item => item.ID == parts[0])?.Milestones
                    .GetValueOrDefault(parts[1][..^" milestone".Length])
                : folders.SelectMany(folder => folder.Subdoctrines).FirstOrDefault(item => item.ID == parts[0])?.Rewards
                    .FirstOrDefault(reward => reward.ID == parts[1])?.Effects;
        return DoctrineInfo.Summarize(dto);
    }

    private string DoctrineName(string id)
    {
        var folders = Workspace.Catalog.DoctrineFolders;
        return folders.SelectMany(folder => folder.GrandDoctrines).FirstOrDefault(item => item.ID == id)?.Name
               ?? folders.SelectMany(folder => folder.Subdoctrines).FirstOrDefault(item => item.ID == id)?.Name
               ?? id;
    }

