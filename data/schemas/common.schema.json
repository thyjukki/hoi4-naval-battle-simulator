{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "NavySimulator Common Definitions",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "mioId": {
      "type": "string",
      "minLength": 1,
      "description": "An MIO ID from mios/ (imported by NavySimulator import-mios; the game's organization IDs).",
      "examples": [
        "USA_brooklyn_naval_yard_organization",
        "JAP_kure_naval_arsenal_organization"
      ]
    },
    "mioBonus": {
      "type": "object",
      "description": "S-STATS-MIO: equipment stat bonuses by the game's stat key, e.g. armor_value = 0.05.",
      "additionalProperties": {
        "type": "number"
      }
    },
    "researchId": {
      "type": "string",
      "enum": [
        "damage_control_1",
        "damage_control_2",
        "fire_control_methods_1",
        "fire_control_methods_2",
        "fire_control_methods_2_ca",
        "fire_control_methods_3",
        "fire_control_methods_3_cruiser",
        "fire_control_methods_3_dd",
        "heavy_upgrade_1",
        "heavy_upgrade_2",
        "light_upgrade_1",
        "light_upgrade_2",
        "smoke_generator",
        "sp_torpedo_cruiser_eq_bonus_light_attack",
        "sp_torpedo_cruiser_eq_bonus_torpedo",
        "torpedo_upgrade_1",
        "torpedo_upgrade_2"
      ]
    },
    "spiritId": {
      "type": "string",
      "minLength": 1,
      "description": "A spirit ID from spirits/ (imported by NavySimulator import-doctrines; the game's idea IDs).",
      "examples": [
        "decisive_battle_spirit",
        "efficient_communications_spirit",
        "night_fighting_spirit",
        "close_combat_navy_spirit"
      ]
    },
    "countryEffects": {
      "type": "object",
      "description": "S-DOCTRINE-EFFECT: what a doctrine part or spirit gives its country, with the game's script keys.",
      "properties": {
        "countryModifiers": {
          "type": "object",
          "description": "Country modifiers by game key (S-STATS-COUNTRY).",
          "additionalProperties": {
            "type": "number"
          }
        },
        "unitBonuses": {
          "type": "object",
          "description": "Sub-unit bonuses by sub-unit or sub-unit category, then by game stat key (S-STATS-SHIP).",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "equipmentBonuses": {
          "type": "object",
          "description": "equipment_bonus blocks by equipment type, archetype or hull, then by game stat key (S-STATS-BONUS).",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "scripted": {
          "type": "array",
          "description": "Script parts the simulator does not run (effect, enable_tactic = x, research_bonus, ...).",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "shipRole": {
      "type": "string",
      "enum": ["Screen", "Capital", "Carrier", "Submarine", "Convoy"]
    },
    "shipStats": {
      "type": "object",
      "description": "Numeric stat map. Allows known stats and other numeric keys for imported/experimental values.",
      "properties": {
        "speed": { "type": "number" },
        "reliability": { "type": "number" },
        "organization": { "type": "number" },
        "hp": { "type": "number" },
        "surfaceVisibility": { "type": "number" },
        "subVisibility": { "type": "number" },
        "surfaceDetection": { "type": "number" },
        "subDetection": { "type": "number" },
        "carrierSubDetection": { "type": "number" },
        "carrierSurfaceDetection": { "type": "number" },
        "carrierSize": { "type": "number" },
        "navalRange": {
          "type": "number"
        },
        "lightAttack": { "type": "number" },
        "lightPiercing": { "type": "number" },
        "heavyAttack": { "type": "number" },
        "heavyPiercing": { "type": "number" },
        "torpedoAttack": { "type": "number" },
        "depthChargeAttack": { "type": "number" },
        "antiAir": { "type": "number" },
        "armor": { "type": "number" },
        "torpedoDamageReductionFactor": { "type": "number" },
        "torpedoEnemyCriticalChanceFactor": { "type": "number" },
        "torpedoHitChanceFactor": { "type": "number" },
        "depthChargeHitChanceFactor": { "type": "number" },
        "lightHitChangeFactor": { "type": "number" },
        "lightHitChanceFactor": { "type": "number" },
        "heavyHitChanceFactor": { "type": "number" },
        "navalWeatherPenaltyFactor": { "type": "number" },
        "productionCost": { "type": "number" }
      },
      "additionalProperties": false
    },
    "admiral": {
      "type": "object",
      "description": "S-ADMIRAL: a navy leader's skills and traits, as a character's navy_leader block has them.",
      "properties": {
        "id": {
          "type": "string",
          "description": "The character ID, e.g. USA_chester_w_nimitz. In a scenario: the character the admiral was picked from, empty for a made-up one."
        },
        "name": {
          "type": "string",
          "description": "The game's name (localisation)."
        },
        "country": {
          "type": "string",
          "description": "The tag of the country that recruits the character."
        },
        "skill": {
          "type": "integer",
          "minimum": 0,
          "default": 1,
          "description": "The overall skill level."
        },
        "attackSkill": {
          "type": "integer",
          "minimum": 0,
          "default": 1,
          "description": "Attack skill level (leader-skills/: attack_skill)."
        },
        "defenseSkill": {
          "type": "integer",
          "minimum": 0,
          "default": 1,
          "description": "Defense skill level."
        },
        "maneuveringSkill": {
          "type": "integer",
          "minimum": 0,
          "default": 1,
          "description": "Maneuvering skill level."
        },
        "coordinationSkill": {
          "type": "integer",
          "minimum": 0,
          "default": 1,
          "description": "Coordination skill level."
        },
        "traits": {
          "type": "array",
          "description": "Leader trait IDs from leader-traits/.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
