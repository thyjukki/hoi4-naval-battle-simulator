{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spirits.schema.json",
  "title": "NavySimulator Spirits",
  "description": "Navy and air spirits, written by NavySimulator import-doctrines (S-SPIRIT).",
  "type": "object",
  "required": [
    "spirits"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "spirits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/spiritId"
          },
          "name": {
            "type": "string",
            "description": "The game's name (localisation)."
          },
          "category": {
            "type": "string",
            "description": "The idea category (spirit slot), e.g. naval_command_spirit."
          },
          "categoryName": {
            "type": "string"
          },
          "requiredDoctrines": {
            "type": "array",
            "description": "has_doctrine conditions of the available trigger: each group needs one of its doctrines; every group must be met.",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "otherConditions": {
            "type": "array",
            "description": "Other available/visible conditions as script text (not checked).",
            "items": {
              "type": "string"
            }
          },
          "effects": {
            "$ref": "common.schema.json#/$defs/countryEffects"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
