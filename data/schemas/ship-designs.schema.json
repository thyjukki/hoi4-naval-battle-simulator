{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ship-designs.schema.json",
  "title": "NavySimulator Ship Designs",
  "type": "object",
  "required": [
    "shipDesigns"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "shipDesigns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "hullID",
          "modules"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "hullID": {
            "type": "string",
            "minLength": 1,
            "description": "A hull ID from hulls/, e.g. ship_hull_cruiser_3."
          },
          "modules": {
            "type": "object",
            "description": "Slot ID -> module ID. Slots left out are empty.",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "mioID": {
            "$ref": "common.schema.json#/$defs/mioId"
          },
          "allowAnyModule": {
            "type": "boolean",
            "description": "Override the designer's module restrictions (allowed categories, forbidden modules, count limits, required slots)."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
