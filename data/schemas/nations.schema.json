{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nations.schema.json",
  "title": "NavySimulator Nations",
  "description": "What countries' history files and focus trees give their navies, written by NavySimulator import-national (S-NATIONAL). Only content with modelled naval combat effects is kept.",
  "type": "object",
  "required": [
    "nations"
  ],
  "$defs": {
    "effect": {
      "type": "object",
      "description": "S-NATIONAL-EFFECT: one effect statement of the history or a focus reward.",
      "required": [
        "effect",
        "target"
      ],
      "properties": {
        "effect": {
          "enum": [
            "add_ideas",
            "remove_ideas",
            "add_dynamic_modifier",
            "remove_dynamic_modifier",
            "set_variable",
            "add_to_variable",
            "subtract_from_variable",
            "multiply_variable"
          ]
        },
        "target": {
          "type": "string",
          "description": "The national spirit, dynamic modifier or variable."
        },
        "value": {
          "type": "number",
          "description": "The variable operand."
        },
        "condition": {
          "type": "string",
          "description": "The limit of the if the statement is in (the simulator takes the if branch), as script text."
        },
        "days": {
          "type": "integer",
          "description": "A timed idea or modifier's days; the simulator treats it as active."
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "nations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The country tag, e.g. JAP."
          },
          "name": {
            "type": "string"
          },
          "focusTree": {
            "type": "string"
          },
          "spirits": {
            "type": "array",
            "description": "S-NATIONAL-SPIRIT: national spirits (ideas outside the spirit slots) the country can have.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "category"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "category": {
                  "type": "string",
                  "description": "The idea category, e.g. country or hidden_ideas."
                },
                "sources": {
                  "type": "array",
                  "description": "history, focus:<focus>, <TAG> focus:<focus> (another country gives it), allowed, id (its ID prefix names the country) or against:<TAG>.",
                  "items": {
                    "type": "string"
                  }
                },
                "effects": {
                  "$ref": "common.schema.json#/$defs/countryEffects"
                },
                "targetedModifiers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "tag"
                    ],
                    "properties": {
                      "tag": {
                        "type": "string"
                      },
                      "modifiers": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "number"
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "dynamicModifiers": {
            "type": "array",
            "description": "S-NATIONAL-DM: dynamic modifiers the history or focuses add.",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "modifiers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                },
                "variableModifiers": {
                  "type": "object",
                  "description": "Modifier key to the country variable that gives its value.",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "history": {
            "type": "array",
            "description": "S-NATIONAL-HISTORY: the history file's effects at the 1936 start.",
            "items": {
              "$ref": "#/$defs/effect"
            }
          },
          "focuses": {
            "type": "array",
            "description": "S-NATIONAL-FOCUS: focuses with such effects, in tree order.",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "mutuallyExclusive": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "effects": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/effect"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
