{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "force-compositions.schema.json",
  "title": "NavySimulator Force Compositions",
  "type": "object",
  "required": ["fleets"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "fleets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "shipDesigns"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "shipDesigns": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            }
          },
          "shipExperienceLevels": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            }
          },
          "carrierAirwings": {
            "type": "object",
            "description": "Air wings per carrier, by design ID: one loadout per ship of the design, in ship order (the first is ship 001). Carriers without a loadout have no planes.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "wings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["planeID"],
                      "properties": {
                        "planeID": { "$ref": "common.schema.json#/$defs/id" },
                        "airwings": {
                          "type": "integer",
                          "minimum": 1,
                          "description": "Number of wings (default 1)."
                        },
                        "planeCount": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Planes per wing; 0 or missing means 10."
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

