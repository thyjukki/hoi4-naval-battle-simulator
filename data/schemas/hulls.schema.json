{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hulls.schema.json",
  "title": "NavySimulator Hulls",
  "description": "Written by 'NavySimulator import-ship-data' from common/units/equipment/ship_hull_*.txt.",
  "type": "object",
  "required": [
    "hulls"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "hulls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "archetype",
          "equipmentType",
          "manpower",
          "baseStats",
          "slots"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "archetype": {
            "type": "string",
            "minLength": 1
          },
          "archetypeName": {
            "type": "string"
          },
          "equipmentType": {
            "type": "string",
            "enum": [
              "screen_ship",
              "capital_ship",
              "carrier",
              "submarine"
            ]
          },
          "year": {
            "type": "integer"
          },
          "manpower": {
            "type": "integer",
            "minimum": 1
          },
          "baseStats": {
            "$ref": "common.schema.json#/$defs/shipStats"
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "allowedCategories"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "allowedCategories": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          },
          "moduleCountLimits": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "operator",
                "count"
              ],
              "properties": {
                "modules": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Module IDs, 'any' or 'empty'."
                },
                "categories": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Module categories or 'any'."
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "<",
                    ">",
                    "=",
                    "any"
                  ]
                },
                "count": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            }
          },
          "defaultModules": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
