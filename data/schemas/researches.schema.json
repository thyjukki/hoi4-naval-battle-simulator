{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "researches.schema.json",
  "title": "NavySimulator Researches",
  "type": "object",
  "required": ["researches"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "researches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/researchId" },
          "statModifiers": { "$ref": "#/$defs/shipStats" },
          "statMultipliers": { "$ref": "#/$defs/shipStats" },
          "statAverages": { "$ref": "#/$defs/shipStats" },
          "equipmentBonus": {
            "type": "boolean",
            "description": "True for an idea or named equipment bonus (add_equipment_bonus, e.g. special projects): its values join the design multiplier for every stat (S-STATS-BONUS). False (default) for a technology sub-unit bonus applied on the ship (S-STATS-SHIP)."
          },
          "countryModifiers": {
            "type": "object",
            "description": "Country modifiers by game key, as the technology script declares them at its top level (S-STATS-COUNTRY). They apply to every ship of the side; appliesToRoles and appliesToTypes scope only the stat blocks. Keys the engine does not read yet are ignored with a loader warning.",
            "properties": {
              "naval_retreat_speed": { "type": "number", "description": "Added to the daily escape speed of warships (S-RETREAT-SPEED)." },
              "naval_retreat_speed_after_initial_combat": { "type": "number", "description": "Added to the daily escape speed of warships after COMBAT_INITIAL_DURATION hours." },
              "sub_retreat_speed": { "type": "number", "description": "Added to the daily escape speed of submarines." },
              "convoy_retreat_speed": { "type": "number", "description": "Added to the daily escape speed of convoys." }
            },
            "additionalProperties": { "type": "number" }
          },
          "appliesToRoles": {
            "type": "array",
            "items": { "$ref": "#/$defs/shipRole" },
            "uniqueItems": true
          },
          "appliesToTypes": {
            "type": "array",
            "items": { "$ref": "#/$defs/shipType" },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "shipRole": {
      "type": "string",
      "enum": ["Screen", "Capital", "Carrier", "Submarine", "Convoy"]
    },
    "shipType": {
      "type": "string",
      "minLength": 1,
      "description": "A ship type (sub-unit) ID from ship-types/, a hull ID or a hull archetype (matched against ShipDesign.Types).",
      "examples": ["destroyer", "light_cruiser", "heavy_cruiser", "battle_cruiser", "battleship", "sh_battleship", "carrier", "sh_carrier", "submarine", "ship_hull_torpedo_cruiser"]
    },
    "shipStats": {
      "type": "object",
      "properties": {
        "speed": { "type": "number" },
        "reliability": { "type": "number" },
        "organization": { "type": "number" },
        "hp": { "type": "number" },
        "surfaceVisibility": { "type": "number" },
        "subVisibility": { "type": "number" },
        "surfaceDetection": { "type": "number" },
        "subDetection": { "type": "number" },
        "carrierSubDetection": { "type": "number" },
        "carrierSurfaceDetection": { "type": "number" },
        "carrierSize": { "type": "number" },
        "lightAttack": { "type": "number" },
        "lightPiercing": { "type": "number" },
        "heavyAttack": { "type": "number" },
        "heavyPiercing": { "type": "number" },
        "torpedoAttack": { "type": "number" },
        "depthChargeAttack": { "type": "number" },
        "antiAir": { "type": "number" },
        "armor": { "type": "number" },
        "torpedoDamageReductionFactor": { "type": "number" },
        "torpedoEnemyCriticalChanceFactor": { "type": "number" },
        "torpedoHitChanceFactor": { "type": "number" },
        "depthChargeHitChanceFactor": { "type": "number" },
        "lightHitChangeFactor": { "type": "number" },
        "lightHitChanceFactor": { "type": "number" },
        "heavyHitChanceFactor": { "type": "number" },
        "navalWeatherPenaltyFactor": { "type": "number" },
        "productionCost": { "type": "number" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}


